# Copy to .env and adjust. Every value here is the default.
# npm start / npm run dev read .env automatically if it exists.

# 5183 in development. The production image sets 3000.
PORT=5183

# Comma-separated; unset means any origin. Only needed if you deploy this
# server apart from the site — the production image serves both from one
# origin, so there is nothing to allow.
# CORS_ORIGIN=https://example.com

# The built client, served by this same process. Set in the production image;
# leave unset in development, where Vite serves the page on its own port.
# STATIC_DIR=../dist

MAX_PLAYERS=20

# How many outfits the client can render. v1 has one look.
APPEARANCE_COUNT=1

SYNC_INTERVAL_MS=1000
WORLD_BOUND=60
MOVE_RATE_LIMIT=10

# A line of chat has to fit in a bubble over an avatar's head. Longer is
# truncated, not rejected.
CHAT_MAX_LENGTH=120
CHAT_RATE_LIMIT=2
