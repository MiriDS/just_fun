{
  "name": "just_fun_server",
  "version": "0.1.0",
  "private": true,
  "description": "Presence server for the just_fun 3D portfolio: tracks who is in the scene and relays their movement.",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "smoke": "node --env-file-if-exists=.env test/smoke.js"
  },
  "dependencies": {
    "sirv": "^3.0.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.1"
  }
}
